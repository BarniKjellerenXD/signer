# Copy to .env and fill in.

# Machine name in your tailnet. The site will be https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=signer

# Your tailnet's DNS name is on https://login.tailscale.com/admin/dns (looks like tail1234.ts.net)
PUBLIC_URL=https://signer.tail1234.ts.net

# Tailscale login(s) allowed to open /setup, comma separated (e.g. yourname@github, you@gmail.com).
# Not sure? Leave empty, open the site, and read "Signed in as ..." at the bottom of the page.
OWNER_LOGINS=

# One-time auth key from https://login.tailscale.com/admin/settings/keys (needed for the first start only;
# you can delete this line afterwards).
TS_AUTHKEY=

SITE_NAME=Signer
TZ=UTC
